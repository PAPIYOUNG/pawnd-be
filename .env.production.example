# ==============================================================================
# PAWND Backend - Production Environment (.env.production)
# สำหรับตั้งค่าใน Railway Environment: "production"
# ==============================================================================

# Database: ผูกกับ PostgreSQL + pgvector ของ Production ใน Railway
# ใน Railway Variables สามารถใส่: ${{Postgres.DATABASE_URL}} ได้โดยตรง
DATABASE_URL="postgresql://postgres:password@host:port/railway?sslmode=disable"

# Port ที่รันภายใน Container (Railway จะเซ็ตให้อัตโนมัติเป็นค่าของ $PORT)
PORT="8000"

# JWT Authentication (ต้องเป็น Secret Key ที่ไม่ซ้ำกับ Staging)
JWT_SECRET="pawnd-production-jwt-super-secret-key-32-chars-long"
JWT_EXPIRE_IN="604800"

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Frontend URL & CORS (ใส่โดเมน Production หลักของ Vercel)
FRONTEND_URL="https://pawnd.vercel.app"
CORS_ALLOWED_ORIGINS="https://pawnd.vercel.app"

# AI Configuration (OpenRouter Production)
AI_MOCK_MODE="false"
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_ANALYZE_IMAGE_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
AI_ANALYZE_IMAGE_MODEL_FREE="openrouter/free"
AI_IMAGE_EMBEDDING_MODEL="nvidia/llama-nemotron-embed-vl-1b-v2:free"
AI_IMAGE_EMBEDDING_DIMENSION=768
AI_PET_AVATAR_MODEL="bytedance-seed/seed-story"

# Social Authentication
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
LINE_CHANNEL_ID="your_line_channel_id"
LINE_CHANNEL_SECRET="your_line_channel_secret"

# OpenStreetMap Geocoding
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="PAWND/1.0"
NOMINATIM_TIMEOUT_MS="5000"

# Email Verification (Gmail SMTP)
GMAIL_SMTP_USER="your_email@gmail.com"
GMAIL_SMTP_APP_PASSWORD="your_gmail_app_password"

# Optional Test Credentials
TEST_USER_EMAIL="admin@pawnd.co"
TEST_USER_PASSWORD="SecureProductionPassword123!"
